.cache/huggingface/

# ────────────────────── Large binaries we skip ────────────────────
# The .rar archive duplicates the same weights present as .safetensors;
# keep the .safetensors files (committed) and skip the archive.
Img-synthesis/assets/weights/Model_weights_for_inference-Kaggle.rar

